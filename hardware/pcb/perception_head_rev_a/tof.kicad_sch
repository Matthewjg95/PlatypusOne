	(text "VL53L8CX TOF — REV A HOSTS THE POLOLU #3419 CARRIER"
		(exclude_from_sim no)
		(at 10 8 0)
		(effects
			(font
				(size 2.5 2.5)
			)
			(justify left top)
		)
		(uuid "317eb265-5a6c-5fe2-97f6-207e6e9fc5c4")
	)
	(text "TOF — DECISION B: host the proven Pololu #3419 carrier, not the bare VL53L8CX (rationale: hardware/pcb/RESEARCH_LEDGER.md)."
		(exclude_from_sim no)
		(at 10 14 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "bde5207b-aeab-5c32-99ab-e86a314ba0f5")
	)
	(text "Carrier regulates AVDD 3.3 V + CORE/IOVDD 1.8 V and level-shifts all I/O to VIN (NXS0108). VIN = +3V3_TOF (3.43 V)."
		(exclude_from_sim no)
		(at 10 17.2 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "e4614381-8b7a-5ce5-b43f-c28f7dc176f5")
	)
	(text "Dedicated bus I2C_B: Pololu warns its shifter is load-sensitive (keep wires < 8 cm, few devices) and the"
		(exclude_from_sim no)
		(at 10 20.4 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "2baccf10-35cc-5341-8bf8-5e3166068f49")
	)
	(text "  ToF rail is power-cycled for reset — isolating it keeps IMU/EEPROM on bus A alive during ToF recovery."
		(exclude_from_sim no)
		(at 10 23.6 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "b2d46c9a-6188-5c06-93f3-9e1a62a61aea")
	)
	(text "Address 0x29 (7-bit; 0x52 8-bit). Firmware (~84 KB) is uploaded by the ULD at every power-up."
		(exclude_from_sim no)
		(at 10 26.8 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "caf369a1-fb4a-535c-938b-df06a198ad12")
	)
	(text "SPI/I2C pin strapped LOW by R9 (I2C mode). R10 DNP_OPTION lets expander P2 toggle it (I2C-interface reset only)."
		(exclude_from_sim no)
		(at 10 30 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "8b0fa40b-165b-56aa-904d-901470f23bc0")
	)
	(text "R28 100k keeps expander P2 defined while R10 is not fitted (if R10 is fitted, firmware must drive P2 low)."
		(exclude_from_sim no)
		(at 10 33.2 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "f8fbaa7f-eedf-57eb-af3c-5d8883222d24")
	)
	(text "MISO and CS unused in I2C mode (carrier pulls CS high). SPI is a Rev B option, not wired."
		(exclude_from_sim no)
		(at 10 36.4 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "6ca0a4db-b6b1-5d3f-8108-ab1f038b13ce")
	)
	(text "Bus B crosses the host cable: C18/C19 DNP_OPTION (22 pF) per Pololu note on shifter oscillation; scope it (BENCH_VERIFY)."
		(exclude_from_sim no)
		(at 10 39.6 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "58d5e29d-9686-5c3c-8e5e-bc7a841670f3")
	)
	(text "TOF_SYNC: host-driven ranging trigger for camera/ToF timing experiments. Keep LOW/Hi-Z while ToF rail is off."
		(exclude_from_sim no)
		(at 10 42.8 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "7d5c38c8-260f-51a0-bc23-86a1e23f87a5")
	)
	(text "AVDD and CORE/IOVDD carrier outputs go only to test points (BENCH_VERIFY AVDD >= 3.13 V during 8x8 ranging)."
		(exclude_from_sim no)
		(at 10 46 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "5ac8e7b4-5453-5c94-b336-853561b6acfa")
	)
	(text "MECHANICAL: carrier is soldered on headers + 2x M2 to the head PCB; its pose is part of the camera<->ToF extrinsic."
		(exclude_from_sim no)
		(at 10 49.2 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
