		(uuid "ab7e87bc-897e-5c12-a1f5-1582aee6793b")
	)
	(text "J1 = single locking host cable. JST GH 1.25 mm 14-pin chosen for Rev A bench: locking, 1 A/contact, cheap prebuilt cables."
		(exclude_from_sim no)
		(at 10 17.2 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "db22f72b-fb81-53b8-af5f-812584c0fdf9")
	)
	(text "J1 pin order is a BENCH/MECH decision: re-order freely until the host-carrier connector is frozen."
		(exclude_from_sim no)
		(at 10 20.4 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "7d7c5315-58e8-5739-b84f-b2e38ddeb39a")
	)
	(text "Host-side mapping (Rev A bench harness, UNO Q, NOT final pins):"
		(exclude_from_sim no)
		(at 10 23.6 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "f0bdea34-bc7c-5493-8fdb-1cf158fa8489")
	)
	(text "  I2C_A = UNO Q Qwiic I2C4 PD12/PD13 (2.2k pull-ups on UNO Q)   I2C_B = JDIGITAL D21/D20 I2C2 PB10/PB11 (TBD_HOST_I2C_B)"
		(exclude_from_sim no)
		(at 10 26.8 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "58ee5eb8-a46b-54a0-8b43-2d863b01903c")
	)
	(text "  TOF_INT_N, TOF_SYNC, IMU_INT1 -> TBD_INT on JDIGITAL 3.3 V pins   ILLUM_SET -> TBD_PWM or A0/A1 DAC (STM32 DAC1)"
		(exclude_from_sim no)
		(at 10 30 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "b56e272a-3c16-5269-bdc8-46bb7545caa7")
	)
	(text "  +5V_HOST -> JANALOG 5V (BENCH_VERIFY: present when UNO Q is powered from DC_IN?)   +3V3_HOST -> Qwiic/JANALOG 3V3"
		(exclude_from_sim no)
		(at 10 33.2 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "063985a8-55c0-5f2c-b135-6590ea26c4fc")
	)
	(text "J2 Qwiic = bench/daisy-chain path for bus A only. Never connect J1 and J2 to two different hosts (3V3 rails would tie)."
		(exclude_from_sim no)
		(at 10 36.4 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "58580eb0-51ec-5733-b08f-6a32e70030a0")
	)
	(text "R1/R2 bus-A pull-ups DNP_OPTION: host already has 2.2k. R3/R4 bus-B pull-ups DNP_OPTION: Pololu shifter has 10k to VIN."
		(exclude_from_sim no)
		(at 10 39.6 0)
		(effects
