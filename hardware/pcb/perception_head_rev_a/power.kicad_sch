	(text "POWER ENTRY, MEASUREMENT SHUNTS, SWITCHABLE TOF RAIL"
		(exclude_from_sim no)
		(at 10 8 0)
		(effects
			(font
				(size 2.5 2.5)
			)
			(justify left top)
		)
		(uuid "58fd9e9d-d3a4-5155-a9dd-9eafcbb93e2e")
	)
	(text "POWER — rails come from the host; the head makes only the switchable ToF rail."
		(exclude_from_sim no)
		(at 10 14 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "36e0e5ca-c321-5c1d-86d3-81e3a0d36676")
	)
	(text "+5V_HOST -(SH1 0.05R)-> +5V_HEAD : feeds ToF LDO and illumination switch. Head 5 V current = V(SH1)/0.05."
		(exclude_from_sim no)
		(at 10 17.2 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "084de4a5-f873-5062-9007-8dc548928cc6")
	)
	(text "+3V3_HOST -(SH3 1R)-> +3V3_LOGIC : IMU, EEPROM, expander, op-amp. Logic current = V(SH3)/1 (expect low mA)."
		(exclude_from_sim no)
		(at 10 20.4 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "1ac504dc-fad0-588c-955b-f33c58eb6211")
	)
	(text "U1 TLV75801P -> TOF_LDO_OUT -(SH2 0.1R)-> +3V3_TOF : Pololu VIN. Off by default (R7 pulls EN low)."
		(exclude_from_sim no)
		(at 10 23.6 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "15c14ff3-7807-5a87-b2d7-061d036d66ad")
	)
	(text "Vout = 0.55 V x (1 + R5/R6) = 0.55 x (1 + 49.9k/10k) = 3.29 V nominal (3.23-3.36 V: 1% Vref + 0.5% R5/R6)."
		(exclude_from_sim no)
		(at 10 26.8 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "db7ebb24-7b48-5daa-88d4-98550a04b9a4")
	)
	(text "Why 3.30 V: Pololu host-side I/O follows VIN, so VIN stays in the host's 3.3 V logic domain (same condition as the Lab rig)."
		(exclude_from_sim no)
		(at 10 30 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "ee33b41e-e748-5a94-b340-d6e84cd6cd0a")
	)
	(text "  Every bus-B/INT/SYNC crossing then stays within STM32 VDD+0.3 V and NXS0108 VIH = VCC(B)-0.4 V (ICD sec 5a)."
		(exclude_from_sim no)
		(at 10 33.2 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "9640d447-bd08-505b-894b-c786e4de6002")
	)
	(text "  BENCH_VERIFY AVDD >= 3.13 V during 8x8 ranging (T2). 3.43 V (R5 = 52.3k) is a CONDITIONAL fallback only (ICD sec 5a)."
		(exclude_from_sim no)
		(at 10 36.4 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "d088086b-c0b8-5c0f-988b-644658bf1089")
	)
	(text "Why a switchable rail: VL53L8CX reset = remove all supplies for 10 ms (ST UM3109 sec 4.2). TLV758P has active discharge."
		(exclude_from_sim no)
		(at 10 39.6 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "c95e9e63-2df9-56ab-9543-bc96e79076ab")
	)
	(text "R8 DNP_OPTION 'TOF_FORCE_ON': populate to power ToF without firmware (bench only)."
		(exclude_from_sim no)
		(at 10 42.8 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "06990e65-16b4-57d7-9b87-04a588eac45d")
	)
	(text "PWR_FLAGs mark rails driven through shunts/connectors so ERC can check power-pin drive."
		(exclude_from_sim no)
		(at 10 46 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "91eb513d-cf94-5905-96f1-278ac38db456")
	)
