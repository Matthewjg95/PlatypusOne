	(text "CONTROLLED WHITE ILLUMINATION — 2-CHANNEL LINEAR CONSTANT-CURRENT SINK"
		(exclude_from_sim no)
		(at 10 8 0)
		(effects
			(font
				(size 2.5 2.5)
			)
			(justify left top)
		)
		(uuid "d2d52a9a-06b9-56d8-bff3-13b59c5def6b")
	)
	(text "ILLUMINATION — LED current NOT frozen. Topology frozen-candidate: switched 5 V + linear constant-current sinks."
		(exclude_from_sim no)
		(at 10 14 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "f98bb1c7-d1f6-5351-b2d1-d1ea98ddcc2d")
	)
	(text "Why linear CC (not resistor, not buck): brightness independent of 5 V droop and LED Vf; no switching noise next to"
		(exclude_from_sim no)
		(at 10 17.2 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "3a249c41-de90-5bb1-b1fe-7381eb3c476b")
	)
	(text "  camera/ToF; analog set-point means NO PWM banding on the IMX219 rolling shutter (PWM-dim only as last resort)."
		(exclude_from_sim no)
		(at 10 20.4 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "ea4d2e09-a6fc-5e45-97e1-62e89431d086")
	)
	(text "I_LED(per ch) = V(ILLUM_VSET) / 1 ohm. ILLUM_VSET = ILLUM_SET x 10k/(120k+10k): 3.3 V -> 254 mA full scale."
		(exclude_from_sim no)
		(at 10 23.6 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "8014f01f-a652-563b-a276-1a9e5085de06")
	)
	(text "ILLUM_SET source: STM32 DAC (A0/A1) preferred, or TBD_PWM >= 20 kHz filtered by R17/C13 (tau ~2 ms)."
		(exclude_from_sim no)
		(at 10 26.8 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "068de17d-bb93-5fa2-ada9-b29043a5cc32")
	)
	(text "Off paths (defence in depth): ILLUM_SET low/floating -> R17 pulls VSET to 0; ILLUM_EN low -> U3 off (R13);"
		(exclude_from_sim no)
		(at 10 30 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "0bc43141-2014-5c48-9b97-a1ab4fc7d3b3")
	)
	(text "  JP1 closed -> ILLUM_EN hard-grounded (illumination kill); R27 1k keeps the expander from fighting JP1."
		(exclude_from_sim no)
		(at 10 33.2 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "84a7d780-0bef-5110-83fa-427544fd48ed")
	)
	(text "FIRMWARE RULE: set ILLUM_SET = 0 before toggling ILLUM_EN, then ramp (op-amps saturate while U3 is off)."
		(exclude_from_sim no)
		(at 10 36.4 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "3efde398-332a-517f-9f1e-04f58cfc3e8f")
	)
	(text "U3 TPS2553 limit: R15 = 40.2k -> IOS 592/647/709 mA min/nom/max (SLVS841F eq.1) > 2 x 254 mA. Protects host 5 V."
		(exclude_from_sim no)
		(at 10 39.6 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "42c88729-4bac-5a48-9e3e-d583bf6f357a")
	)
	(text "Q1/Q2 dissipation at 254 mA: (5.0 - Vf ~3.0 - 0.25) x 0.25 = ~0.45 W each continuous -> SOT-223 + copper; BENCH thermal."
		(exclude_from_sim no)
		(at 10 42.8 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "1f03b2cf-bf90-509f-9c8d-6794a20e16e1")
	)
	(text "LEDs live on small off-board light boards (J3/J4) so position/angle/diffuser can iterate without respinning the head."
		(exclude_from_sim no)
		(at 10 46 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "3c3d8726-3d2c-5cdf-a910-de2c0b686e01")
	)
