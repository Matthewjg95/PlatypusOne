		)
		(uuid "1c0e0950-4044-54c7-b8c9-0ecd2fa5c8f2")
	)
	(text "ID / CALIBRATION — smallest robust option: one 32-Kbit EEPROM with a factory 128-bit unique serial number."
		(exclude_from_sim no)
		(at 10 14 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "8ce915e9-46f3-5a4e-b097-8b450f5a6262")
	)
	(text "AT24CS32 on bus A: array at 0x50, read-only serial number in the separate 0x58 'security' address space"
		(exclude_from_sim no)
		(at 10 17.2 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "eedd10ab-85f2-5049-afc9-e8be992ad050")
	)
	(text "  (read: dummy write word address 0x0800 to 0x58, then read 16 bytes - Atmel-8869C sec 10)."
		(exclude_from_sim no)
		(at 10 20.4 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "e644f1e8-d90e-5566-8709-a7c43f9bd558")
	)
	(text "WP pulled HIGH by R24 = write-protected by default. Host enables writes via expander P4 (EEPROM_WP low)."
		(exclude_from_sim no)
		(at 10 23.6 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "223f1aec-401b-5337-8b70-a0447f51aa2a")
	)
	(text "Contents: compact versioned record (schema id, board rev, assembly variant, camera id, ToF carrier id,"
		(exclude_from_sim no)
		(at 10 26.8 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "84dbb89e-1c8b-5898-9f2a-ec11f177183a")
	)
	(text "  extrinsic camera<->ToF, intrinsics reference/hash, calibration rev/date, test state) + CRC,"
		(exclude_from_sim no)
		(at 10 30 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "9a924e93-d1ac-52b5-9214-de23327e8377")
	)
	(text "  plus the 776-byte VL53L8CX crosstalk buffer (ST AN5939: host stores it, loads it at every start-up)."
		(exclude_from_sim no)
		(at 10 33.2 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "08de06bf-f7aa-55d9-a05e-a6b62cc43b23")
	)
	(text "Full calibration files stay on the host, keyed by the serial number; EEPROM holds identity + compact pose."
		(exclude_from_sim no)
		(at 10 36.4 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "e5c571a1-83c2-5d75-971d-0add9bde26ef")
	)
